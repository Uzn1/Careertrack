NUXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# 서버에서만 사용합니다. 현재 AI 호출 기능은 연결되지 않았습니다.
OPENROUTER_API_KEY=

# 그로블 연결 준비용입니다. 현재 앱에서는 사용하지 않습니다.
# 상품을 만든 뒤 결제창 주소를 입력합니다. 지금은 비워 두세요.
GROBLE_CHECKOUT_URL=
# 웹훅 수신 서버를 만든 뒤 해당 서버의 비밀 설정에도 등록합니다.
GROBLE_WEBHOOK_SECRET=
